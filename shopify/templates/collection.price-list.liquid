{%- layout none -%}
{%- comment -%}
  templates/collection.price-list.liquid  (shopify-price-list-csv-xml-template kit)

  Price list (cjenik) as CSV, per Odluka o objavi cjenika proizvoda i usluga
  kao mjeri izravne kontrole cijena (NN 101/2026-1213).

  URL:     /collections/all?view=price-list&page=1&sort_by=created-ascending
  Format:  separator ';', decimal comma, UTF-8, one line per variant, LF line endings.
  Paging:  250 products per page. Every page starts with the header line and ends with ONE
           control line that starts with '#meta;' (page, total pages, total products, products
           listed/skipped on this page, currency, country, VAT mode). The GitHub script uses it
           to prove that it received every product in the right currency, then removes it.
           The published files never contain the '#meta' line.

  Price model (the ONLY one supported):
    - variant.price            = what the customer pays today
    - variant.compare_at_price = set ONLY during a real, temporary sale (the regular price)
    => compare-at > price  ->  posebni_oblik_prodaje = DA
                               naziv_posebnog_oblika_prodaje = product metafield pricing.sale_name
                                 -> shop metafield pricing.sale_name -> 'Akcija'
    => otherwise           ->  NE, empty name

  Anchor price: variant metafield pricing.anchor_price (money), filled by Shopify Flow.

  Do not edit this file per store. Everything store-specific lives in metafields or in
  the GitHub repo's config.json. All output goes through `echo` inside {% liquid %} tags,
  so no stray whitespace or blank lines can appear.
{%- endcomment -%}
{%- liquid
  assign nl = '%0A' | url_decode
  assign cr = '%0D' | url_decode
  assign default_sale_name = shop.metafields.pricing.sale_name.value | strip | default: 'Akcija'

  echo 'naziv;sifra;marka;jedinica_mjere;cijena_za_jedinicu_mjere;maloprodajna_cijena;posebni_oblik_prodaje;naziv_posebnog_oblika_prodaje;sidrena_cijena;barkod;dostupnost'
  echo nl
-%}
{%- paginate collection.products by 250 -%}
{%- liquid
  assign listed = 0
  assign skipped = 0
  assign truncated = 0

  for product in collection.products
    if product.gift_card?
      assign skipped = skipped | plus: 1
      continue
    endif
    assign listed = listed | plus: 1
    if product.variants_count and product.variants_count > product.variants.size
      assign truncated = truncated | plus: 1
    endif

    for variant in product.variants
      # name, SKU, brand, barcode (line breaks removed, quotes doubled for CSV)
      assign item_name = product.title
      unless product.has_only_default_variant
        assign item_name = item_name | append: ' - ' | append: variant.title
      endunless
      assign item_name = item_name | strip_newlines | replace: cr, ' ' | replace: '"', '""'
      assign item_sku = variant.sku | default: variant.id | strip_newlines | replace: cr, '' | replace: '"', '""'
      assign item_brand = product.vendor | strip_newlines | replace: cr, ' ' | replace: '"', '""'
      assign item_barcode = variant.barcode | strip_newlines | replace: cr, '' | replace: '"', '""'

      # retail price (cents -> 29,99)
      assign cents = variant.price
      assign whole = cents | divided_by: 100
      assign rest = cents | modulo: 100
      assign item_price = whole | append: ','
      if rest < 10
        assign item_price = item_price | append: '0'
      endif
      assign item_price = item_price | append: rest

      # special form of sale (posebni oblik prodaje): compare-at above price = on sale
      assign sale_flag = 'NE'
      assign item_sale_name = ''
      if variant.compare_at_price and variant.compare_at_price > variant.price
        assign sale_flag = 'DA'
        assign item_sale_name = product.metafields.pricing.sale_name.value | strip | default: default_sale_name
        assign item_sale_name = item_sale_name | strip_newlines | replace: cr, ' ' | replace: '"', '""'
      endif

      # anchor price: a money metafield renders as cents when output directly
      assign item_anchor = ''
      capture anchor_raw
        echo variant.metafields.pricing.anchor_price.value
      endcapture
      if anchor_raw != blank
        assign cents = anchor_raw | plus: 0
        assign whole = cents | divided_by: 100
        assign rest = cents | modulo: 100
        assign item_anchor = whole | append: ','
        if rest < 10
          assign item_anchor = item_anchor | append: '0'
        endif
        assign item_anchor = item_anchor | append: rest
      endif

      # unit of measure + unit price (only if set on the variant)
      assign item_unit = ''
      assign item_unit_price = ''
      if variant.unit_price_measurement and variant.unit_price
        assign item_unit = variant.unit_price_measurement.reference_unit
        if variant.unit_price_measurement.reference_value != 1
          assign item_unit = variant.unit_price_measurement.reference_value | append: ' ' | append: item_unit
        endif
        assign cents = variant.unit_price
        assign whole = cents | divided_by: 100
        assign rest = cents | modulo: 100
        assign item_unit_price = whole | append: ','
        if rest < 10
          assign item_unit_price = item_unit_price | append: '0'
        endif
        assign item_unit_price = item_unit_price | append: rest
      endif

      if variant.available
        assign item_availability = 'dostupno'
      else
        assign item_availability = 'nedostupno'
      endif

      # one CSV line: text fields quoted, numbers and flags unquoted
      echo '"'
      echo item_name
      echo '";"'
      echo item_sku
      echo '";"'
      echo item_brand
      echo '";"'
      echo item_unit
      echo '";'
      echo item_unit_price
      echo ';'
      echo item_price
      echo ';'
      echo sale_flag
      echo ';"'
      echo item_sale_name
      echo '";'
      echo item_anchor
      echo ';"'
      echo item_barcode
      echo '";'
      echo item_availability
      echo nl
    endfor
  endfor

  # control line for the GitHub script (removed from the published files)
  echo '#meta;page='
  echo paginate.current_page
  echo ';pages='
  echo paginate.pages
  echo ';items='
  echo paginate.items
  echo ';listed='
  echo listed
  echo ';skipped='
  echo skipped
  echo ';truncated='
  echo truncated
  echo ';currency='
  echo cart.currency.iso_code
  echo ';country='
  echo localization.country.iso_code
  echo ';taxes_included='
  echo cart.taxes_included
  echo nl
-%}
{%- endpaginate -%}
